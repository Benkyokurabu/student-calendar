# Copy this file to .env and fill values from your Zoom Server-to-Server OAuth app.
# Do not paste these secrets into chat.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Microsoft Graph delegated app settings for Excel cell-level writes.
# Create these in Microsoft Entra/Azure app registration; keep real values in .env only.
GRAPH_CLIENT_ID=
GRAPH_TENANT=consumers
